{
    "name": "github-date-converter",
    "private": true,
    "version": "0.1.0",
    "description": "Convert GitHub dates to standard numerical formats, supports custom formats.",
    "author": "dumeng",
    "license": "MIT",
    "homepage": "https://github.com/dumeng-chn/github-date-converter",
    "repository": {
        "type": "git",
        "url": "https://github.com/dumeng-chn/github-date-converter.git"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "watch": "vite build --watch",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "format": "prettier --write .",
        "preinstall": "npx only-allow pnpm",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.2",
        "@commitlint/config-conventional": "^20.5.0",
        "@eslint/js": "^10.0.1",
        "@typescript-eslint/eslint-plugin": "^8.59.1",
        "@typescript-eslint/parser": "^8.59.1",
        "eslint": "^10.2.1",
        "globals": "^17.5.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.1",
        "vite": "^7.3.2",
        "vite-plugin-monkey": "^7.1.9"
    },
    "dependencies": {
        "dayjs": "^1.11.20"
    }
}